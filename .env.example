# ============================================================================
# CHECKLIST SEBELUM DEPLOY KE INTERNET (jangan skip salah satu):
#   1. POSTGRES_PASSWORD: isi dengan password kuat di .env
#      ini SAJA. docker-compose.yml membaca variabel ini; jangan edit password
#      langsung di docker-compose.yml. DATABASE_URL di bawah harus cocok.
#   2. AUTH_SECRET: generate baru, JANGAN pakai punya dev.
#      `openssl rand -base64 32`
#   3. SEED_ADMIN_PASSWORD: isi dengan password kuat sebelum
#      `docker compose run --rm migrate db seed`. Wajib diisi — seed akan
#      gagal bila variabel ini kosong (tidak ada password default).
#   4. MQTT_USERNAME / MQTT_PASSWORD: generate baru via `mosquitto_passwd`
#      (lihat firmware/pelletq_esp32/README.md), bukan kredensial dev.
#   5. TUNNEL_TOKEN: buat tunnel di dashboard Cloudflare Zero Trust ->
#      Networks -> Tunnels, lalu tambahkan dua public hostname: domain app
#      -> http://app:3000, domain MQTT -> http://mosquitto:9001. Token
#      tunnel diisi di sini. Lihat README bagian "Deploy ke Server Sendiri".
#   6. Firmware ESP32: isi WIFI_SSID/PASSWORD, MQTT_BROKER (domain publik,
#      wss:// lewat Cloudflare Tunnel), MQTT_USERNAME/PASSWORD dengan
#      kredensial produksi, bukan bench-test.
#   7. Mosquitto passwd permissions: pastikan password file dapat dibaca UID
#      mosquitto dalam container (default 1883). Bila broker gagal tanpa log
#      jelas, jalankan `chmod 644 mosquitto/config/passwd`.
# ============================================================================

# Cloudflare Tunnel - dari dashboard Zero Trust setelah membuat tunnel.
# Menggantikan Caddy + port forwarding (server ini boleh di belakang CGNAT).
TUNNEL_TOKEN=""

# Database
POSTGRES_PASSWORD="ganti-dengan-password-kuat"
DATABASE_URL="postgresql://pelletq:ganti-dengan-password-kuat@localhost:5432/pelletq?schema=public"

# MQTT
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Gemini API (opsional). Tanpa ini, aplikasi tetap berjalan normal.
GEMINI_API_KEY=""

# Auth.js - WAJIB diisi. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Self-host di belakang reverse proxy (produksi non-Vercel): set "true".
AUTH_TRUST_HOST="true"

# Kredensial admin awal, dipakai `pnpm prisma db seed`.
SEED_ADMIN_USERNAME="pelletq"
SEED_ADMIN_PASSWORD=""
