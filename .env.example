# Database
DATABASE_URL="postgresql://pelletq:pelletq_dev_password@localhost:5432/pelletq?schema=public"

# MQTT
MQTT_BROKER_URL="mqtt://localhost:1883"

# Gemini API (isi nanti)
GEMINI_API_KEY=""

# Auth.js — WAJIB diisi. Generate: openssl rand -base64 32  (atau npx auth secret)
AUTH_SECRET=""

# Self-host di belakang reverse proxy (produksi non-Vercel): set "true".
# Tanpa ini, deteksi host Auth.js bisa gagal → login/redirect rusak.
AUTH_TRUST_HOST="true"

# Kredensial admin awal, dipakai `pnpm prisma db seed`.
# WAJIB diisi untuk produksi — kalau kosong, seed pakai default 'admin321'
# (hanya untuk dev) dan menampilkan peringatan.
SEED_ADMIN_USERNAME="pelletq"
SEED_ADMIN_PASSWORD=""
