# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
*.log
logs/
coverage/
playwright-report/
test-results/

# next.js
/.next/
/out/
/.vercel/
/build/
/dist/

# production
build/
dist/

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
ENV/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# secrets / credentials
.env*
!.env.example
*.pem
firmware/**/secrets.h
mosquitto/config/passwd
mosquitto/config/*.key
mosquitto/config/*.crt
mosquitto/certs/

# firmware / embedded build artifacts
**/.pio/
**/.pioenvs/
**/.piolibdeps/
**/libdeps/
**/.clangd/
**/compile_commands.json
**/build/
firmware/**/build/
firmware/**/.cache/

# ESP-IDF component manager cache (regenerated from idf_component.yml + dependencies.lock)
firmware/**/managed_components/

# ESP-IDF per-environment generated sdkconfig (regenerated from sdkconfig.defaults)
firmware/**/sdkconfig.*
!firmware/**/sdkconfig.defaults

# database / local data
*.sqlite
*.sqlite3
*.db
*.db-journal
prisma/*.db*

# project-local generated files
.claude/
.superpowers/
.worktrees/

# vercel / deploy
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test session cookie jar
test/cookies.txt

# package manager / debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

